  "item": [
    {
      "name": "1. Padrón Nacional (+50,000 Ciudadanos)",
      "item": [
        {
          "name": "GET - Contar Total del Padrón Nacional (RPC +50,000)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rpc/obtener_total_padron",
              "host": ["{{baseUrl}}"],
              "path": ["rpc", "obtener_total_padron"]
            }
          }
        },
        {
          "name": "GET - Listar Ciudadanos (Primeros 50)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ciudadanos?select=*&order=id.desc&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "order", "value": "id.desc" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "GET - Buscar Ciudadano por DNI Exacto",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ciudadanos?dni=eq.40025000&select=*",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"],
              "query": [
                { "key": "dni", "value": "eq.40025000" },
                { "key": "select", "value": "*" }
              ]
            }
          }
        },
        {
          "name": "GET - Buscar en los +50K por Apellido o Ubigeo (Ej. MAMANI en PUNO)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ciudadanos?apellido_paterno=ilike.*MAMANI*&ubigeo=ilike.*PUNO*&select=*&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"],
              "query": [
                { "key": "apellido_paterno", "value": "ilike.*MAMANI*" },
                { "key": "ubigeo", "value": "ilike.*PUNO*" },
                { "key": "select", "value": "*" },
                { "key": "limit", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "POST - Empadronar Nuevo Ciudadano (Con Biometría Facial y Huella)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"76543219\",\n  \"nombres\": \"LUIS FERNANDO\",\n  \"apellido_paterno\": \"QUISPE\",\n  \"apellido_materno\": \"CONDORI\",\n  \"fecha_nacimiento\": \"1999-08-15\",\n  \"estado_civil\": \"SOLTERO\",\n  \"ubigeo\": \"211101 - PUNO / SAN ROMAN / JULIACA\",\n  \"direccion\": \"AV. CIRCUNVALACION 840\",\n  \"donacion_organos\": true,\n  \"biometria_facial\": \"ROSTRO_CAMARA_AFIS_99.8%\",\n  \"biometria_huella\": \"HUELLA_SENSOR_INDICE_DER_OK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ciudadanos",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"]
            }
          }
        },
        {
          "name": "PATCH - Actualizar Biometría Facial/Huella o Domicilio de Ciudadano",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"JR. JAUREGUI 455 - PLAZA DE ARMAS\",\n  \"biometria_facial\": \"ACTUALIZADO_BIOFACIAL_3D_99.9%\",\n  \"biometria_huella\": \"ACTUALIZADO_HUELLA_AFIS_99.7%\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ciudadanos?dni=eq.76543219",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"],
              "query": [
                { "key": "dni", "value": "eq.76543219" }
              ]
            }
          }
        },
        {
          "name": "DELETE - Eliminar Ciudadano por DNI",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/ciudadanos?dni=eq.76543219",
              "host": ["{{baseUrl}}"],
              "path": ["ciudadanos"],
              "query": [
                { "key": "dni", "value": "eq.76543219" }
              ]
            }
          }
        }
      ]
    },
